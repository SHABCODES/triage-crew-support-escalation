# LLM Provider — pick ONE of the two options below.

# Option A: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Option B: Google Gemini (generous free tier via aistudio.google.com/app/apikey)
# Leave OPENAI_API_KEY blank/commented if using this option.
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_MODEL_NAME=gemini/gemini-3.5-flash

# API Key to secure the FastAPI endpoints
API_KEY=your_secure_api_key_here

# Database Config
DATABASE_URL=sqlite:///./triagecrew.db

# ChromaDB Config
CHROMA_PERSIST_DIR=./chroma_db

# Observability (Datadog & LangSmith)
# IMPORTANT: litellm's LangSmith callback specifically reads LANGSMITH_API_KEY
# and LANGSMITH_PROJECT. Get your key from smith.langchain.com/settings —
# it's a different key/page than the older "LangChain API Key" some tutorials
# reference. app/observability.py falls back to LANGCHAIN_API_KEY if that's
# all you have, but setting the right one directly avoids relying on the fallback.
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=triagecrew
DD_API_KEY=your_datadog_api_key_here
DD_AGENT_HOST=datadog-agent

# Only needed to run create_datadog_dashboard.py (one-off provisioning script,
# not needed by the app itself). Generate at Datadog > Organization Settings
# > Application Keys.
DD_APP_KEY=your_datadog_application_key_here
